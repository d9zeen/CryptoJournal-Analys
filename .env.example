# Скопируй этот файл в .env и вставь значения из Supabase:
# Project Settings → API (или Settings → API Keys)
#
# Здесь ТОЛЬКО публичные значения. Они и так попадают в браузер,
# безопасность обеспечивают правила RLS в базе.
# service_role / secret key сюда НЕ вставлять никогда.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon key (eyJ...) или publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
